{
  "name": "dsh-cross-model-bridge",
  "version": "2.1.0",
  "description": "DSH 跨模型/跨账号智能接力桥（v2.1 工业级版）：首+锚点+尾三段式结构化思维抽取、代码块安全保护、Prompt Cache 友好型与防套娃 XML 协议、严格流式生成器与吸顶可视化面板。",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/bridge.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cross-model",
    "smart-handoff",
    "prompt-caching",
    "reasoning",
    "thinking"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "install-profile.ps1",
    "install.cmd",
    "README.md",
    "package.json",
    "LICENSE"
  ]
}
