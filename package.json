{
  "name": "dsh-cross-model-bridge",
  "version": "1.0.2",
  "description": "DSH 跨模型思考桥：切换模型时把上一模型的 reasoning 块降级为正文文本标签，避免思考被静默丢弃，保持推演接力；含滑动窗口与共享记忆注入。",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cross-model",
    "reasoning",
    "thinking"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "package.json",
    "LICENSE"
  ]
}
