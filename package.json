{
  "name": "dsh-cross-model-bridge",
  "version": "2.0.0",
  "description": "DSH 跨模型/跨账号智能接力桥：在切换模型或换账号时，由接手 AI 自感知任务接棒协议，并截取前序关键推演收敛证据，彻底防止报错与思考丢弃；含吸顶可视化记录面板。",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cross-model",
    "smart-handoff",
    "reasoning",
    "thinking"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "install-profile.ps1",
    "install.cmd",
    "README.md",
    "package.json",
    "LICENSE"
  ]
}
