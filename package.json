{
  "name": "dsh-cross-model-bridge",
  "version": "1.1.0",
  "description": "DSH 跨模型思考桥：切换模型时把上一模型的 reasoning 块降级为正文标签（推演接力、防静默丢弃）；含右侧栏实时桥接记录页。",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cross-model",
    "reasoning",
    "thinking"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "install-profile.ps1",
    "install.cmd",
    "README.md",
    "package.json",
    "LICENSE"
  ]
}
